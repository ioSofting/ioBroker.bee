    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
