  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "scripts/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-ts": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.build.json --watch",
    "test": "tsx --test test/*.test.ts",
