{
    "i18n": true,
    "type": "tabs",
    "items": {
        "connection": {
            "type": "panel",
            "label": "Enrollment",
            "items": {
                "hdr1": {
                    "type": "staticText",
                    "text": "Enrollment URL and one-time token come with the factory image or from the fleet manager. After the first successful contact the device holds its own certificate; the token is used up.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "enrollUrl": {
                    "type": "text",
                    "label": "Enrollment URL",
                    "placeholder": "https://beekeeper.one",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "newLine": true
                },
                "enrollToken": {
                    "type": "password",
                    "label": "Enrollment token",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "comment": {
                    "type": "text",
                    "label": "Comment",
                    "help": "Shown in the fleet management next to this installation, e.g. \"Womo Mercedes KA-1525\" (max. 200 characters)",
                    "maxLength": 200,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_connection": {
                    "type": "state",
                    "oid": "info.connection",
                    "label": "Fleet management",
                    "trueText": "connected",
                    "falseText": "not connected",
                    "trueTextStyle": { "color": "#4caf50", "fontWeight": "bold" },
                    "falseTextStyle": { "color": "#f44336", "fontWeight": "bold" },
                    "narrow": true,
                    "addColon": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "_status": {
                    "type": "state",
                    "oid": "info.status",
                    "label": "Status",
                    "narrow": true,
                    "addColon": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 9,
                    "lg": 9,
                    "xl": 9
                }
            }
        },
        "remote": {
            "type": "panel",
            "label": "Remote access",
            "items": {
                "hdr3": {
                    "type": "staticText",
                    "text": "Service staff of the fleet management can open admin or vis-2 of this system from afar, without ioBroker.pro and without open ports: on request, this adapter connects to the fleet server for the duration of the access. Every access is logged with person and purpose, and is shown below while it lasts. Changing these settings ends running accesses. The console is off until you allow it here.",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "allowAdmin": {
                    "type": "checkbox",
                    "label": "Allow remote access to admin",
                    "help": "admin means full access to the system",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "allowVis": {
                    "type": "checkbox",
                    "label": "Allow remote access to vis-2 (web)",
                    "help": "vis-2 shows the values of this system, e.g. consumption",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "allowConsole": {
                    "type": "checkbox",
                    "label": "Allow the console (a shell on this system)",
                    "help": "Only Linux. The shell runs as the user of ioBroker: full access to ioBroker, its data and, depending on the setup, to the system",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "_knxHeader": {
                    "type": "header",
                    "text": "KNX for ETS",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "allowKnx": {
                    "type": "checkbox",
                    "label": "Allow ETS to reach the KNX gateway",
                    "help": "Service staff can program the KNX installation with ETS from afar, through the program bee-knx on their PC. To the gateway below, and to further gateways named in the fleet management if they are in the allowed network (see devices in the network below).",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "knxGateway": {
                    "type": "text",
                    "label": "KNX/IP gateway",
                    "placeholder": "192.168.1.20",
                    "help": "IP address or host name, with :port if not 3671. Empty: as set in the adapter knx or openknx",
                    "hidden": "!data.allowKnx",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "knxTransport": {
                    "type": "select",
                    "label": "Connection to the gateway",
                    "options": [
                        { "value": "auto", "label": "Automatic (TCP if possible, otherwise UDP)" },
                        { "value": "tcp", "label": "TCP" },
                        { "value": "udp", "label": "UDP" }
                    ],
                    "hidden": "!data.allowKnx",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "allowLan": {
                    "type": "checkbox",
                    "label": "Allow devices in the network to be reached",
                    "help": "Service staff can program a device in this network with its own tool from afar, e.g. a LOGO! with LOGO!Soft Comfort or an S7 with TIA Portal, through the program bee-knx on their PC. Which devices, the fleet management says; only inside the networks and ports below, never this device itself.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "lanNetworks": {
                    "type": "text",
                    "label": "Allowed networks",
                    "placeholder": "192.168.0.0/24, 192.168.0.3",
                    "help": "Networks or single addresses, separated by commas; only private ones (10.x, 172.16-31.x, 192.168.x). Empty: the own subnets of this device. Also applies to further KNX gateways.",
                    "hidden": "!data.allowLan && !data.allowKnx",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "lanPorts": {
                    "type": "text",
                    "label": "Allowed ports",
                    "placeholder": "102, 10005",
                    "help": "Separated by commas. Empty: any port. LOGO! 8: 102 and 10005, S7: 102",
                    "hidden": "!data.allowLan",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "_webHeader": {
                    "type": "header",
                    "text": "Web interfaces in the network",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_webText": {
                    "type": "staticText",
                    "text": "Each line is a device in this network whose web interface service staff may open in the browser from the fleet management, by its name, e.g. a router, an inverter or a camera. Address as IP:port, e.g. 192.168.0.1 or 192.168.0.20:8080 (without port: 80), with https:// for HTTPS (port 443 is HTTPS anyway); a host name of this network works too. Only private addresses (10.x, 172.16-31.x, 192.168.x) or this system itself (127.0.0.1). The fleet management sees name and address; the device asks for its own login. An empty table offers nothing.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "webDevices": {
                    "type": "table",
                    "label": "Web interfaces",
                    "uniqueColumns": ["name"],
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        { "type": "text", "attr": "name", "title": "Name", "maxLength": 60, "width": "40%" },
                        { "type": "text", "attr": "address", "title": "IP:port", "width": "60%" }
                    ]
                },
                "_aiHeader": {
                    "type": "header",
                    "text": "AI access (MCP)",
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "allowAi": {
                    "type": "checkbox",
                    "label": "Allow the AI access",
                    "help": "An AI of the fleet management works with the MCP server of ioBroker on this system, only while someone opened it there with purpose and duration. Needs Node.js 22.19",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "aiUser": {
                    "type": "user",
                    "short": true,
                    "label": "Runs as ioBroker user",
                    "help": "The AI has the rights of this user",
                    "hidden": "!data.allowAi",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "aiSetState": {
                    "type": "checkbox",
                    "label": "Also write states",
                    "help": "Otherwise the AI only reads",
                    "hidden": "!data.allowAi",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "aiObjectChange": {
                    "type": "checkbox",
                    "label": "Also change objects and files",
                    "hidden": "!data.allowAi",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "_remoteAccessBy": {
                    "type": "state",
                    "oid": "info.remoteAccessBy",
                    "label": "Remote access in progress",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "maintenance": {
            "type": "panel",
            "label": "Maintenance window",
            "items": {
                "hdr2": {
                    "type": "staticText",
                    "text": "Updates only run inside the maintenance window and when all conditions are met (e.g. installation not in use, battery charged, no roaming, vehicle standing).",
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "windowStart": {
                    "type": "text",
                    "label": "Window start (HH:MM)",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3,
                    "newLine": true
                },
                "windowEnd": {
                    "type": "text",
                    "label": "Window end (HH:MM)",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "ignoreWindow": {
                    "type": "checkbox",
                    "label": "Ignore window (testing only)",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "minFreeMb": {
                    "type": "number",
                    "min": 100,
                    "label": "Minimum free space (MB)",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3,
                    "newLine": true
                },
                "conditions": {
                    "type": "table",
                    "label": "Conditions for updates",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "label",
                            "title": "Label",
                            "width": "25%"
                        },
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": "State",
                            "width": "40%"
                        },
                        {
                            "type": "select",
                            "attr": "op",
                            "title": "Operator",
                            "options": [
                                { "label": "==", "value": "==" },
                                { "label": "!=", "value": "!=" },
                                { "label": ">=", "value": ">=" },
                                { "label": ">", "value": ">" },
                                { "label": "<=", "value": "<=" },
                                { "label": "<", "value": "<" }
                            ],
                            "default": "==",
                            "width": "15%"
                        },
                        {
                            "type": "text",
                            "attr": "value",
                            "title": "Value",
                            "width": "20%"
                        }
                    ]
                }
            }
        },
        "monitoring": {
            "type": "panel",
            "label": "Monitoring",
            "items": {
                "_monitorText": {
                    "type": "staticText",
                    "text": "Each line watches a state. Once its condition holds for longer than the delay, the fleet management shows a deviation with this severity and notifies by mail or Telegram as set there; once the condition is gone for as long, the deviation ends. Example: victron.0.voltage, \"<\", 11.5, Warning. \"No update for (min)\" reports a state that stopped changing, e.g. because its adapter hangs.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "monitors": {
                    "type": "table",
                    "label": "Rules",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        { "type": "text", "attr": "label", "title": "Label", "width": "18%" },
                        { "type": "objectId", "attr": "stateId", "title": "State", "width": "30%" },
                        {
                            "type": "select",
                            "attr": "op",
                            "title": "Reports when",
                            "options": [
                                { "label": "<", "value": "<" },
                                { "label": "<=", "value": "<=" },
                                { "label": ">", "value": ">" },
                                { "label": ">=", "value": ">=" },
                                { "label": "==", "value": "==" },
                                { "label": "!=", "value": "!=" },
                                { "label": "no update for (min)", "value": "stale" }
                            ],
                            "default": "<",
                            "width": "14%"
                        },
                        { "type": "text", "attr": "value", "title": "Value", "width": "10%" },
                        {
                            "type": "select",
                            "attr": "severity",
                            "title": "Severity",
                            "options": [
                                { "label": "Info", "value": "info" },
                                { "label": "Warning", "value": "warning" },
                                { "label": "Error", "value": "error" },
                                { "label": "Critical", "value": "critical" }
                            ],
                            "default": "warning",
                            "width": "14%"
                        },
                        { "type": "number", "attr": "delay", "title": "Delay (s)", "min": 0, "default": 60, "width": "14%" }
                    ]
                }
            }
        },
        "advanced": {
            "type": "panel",
            "label": "Advanced",
            "items": {
                "heartbeatMinutes": {
                    "type": "number",
                    "min": 5,
                    "label": "Heartbeat interval (min)",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "checkMinutes": {
                    "type": "number",
                    "min": 1,
                    "label": "Check interval (min)",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "keepaliveSeconds": {
                    "type": "number",
                    "min": 30,
                    "label": "MQTT keepalive (s)",
                    "help": "Longer saves mobile data",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "signalStateId": {
                    "type": "objectId",
                    "label": "State with signal quality (optional)",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "newLine": true
                },
                "verifySeconds": {
                    "type": "number",
                    "min": 10,
                    "label": "Observation after update (s)",
                    "help": "No new errors in the log during this time",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3,
                    "newLine": true
                },
                "startTimeoutSeconds": {
                    "type": "number",
                    "min": 30,
                    "label": "Start timeout of instances (s)",
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "backupBeforeUpdate": {
                    "type": "checkbox",
                    "label": "Backup before every update",
                    "help": "Disable for tests only",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                }
            }
        }
    }
}
