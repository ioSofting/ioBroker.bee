{
    "i18n": false,
    "type": "tabs",
    "items": {
        "connection": {
            "type": "panel",
            "label": { "en": "Enrollment", "de": "Anmeldung" },
            "items": {
                "hdr1": {
                    "type": "staticText",
                    "text": {
                        "en": "Enrollment URL and one-time token come with the factory image or from the fleet manager. After the first successful contact the device holds its own certificate; the token is used up.",
                        "de": "Enrollment-URL und Einmal-Token kommen mit dem Werksimage oder vom Flottenverwalter. Nach dem ersten erfolgreichen Kontakt hat das Gerät ein eigenes Zertifikat; das Token ist verbraucht."
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "enrollUrl": {
                    "type": "text",
                    "label": { "en": "Enrollment URL", "de": "Enrollment-URL" },
                    "placeholder": "https://bee.iobroker.click",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "newLine": true
                },
                "enrollToken": {
                    "type": "password",
                    "label": { "en": "Enrollment token", "de": "Enrollment-Token" },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "comment": {
                    "type": "text",
                    "label": { "en": "Comment", "de": "Kommentar" },
                    "help": {
                        "en": "Shown in the fleet management next to this installation, e.g. \"Womo Mercedes KA-1525\" (max. 200 characters)",
                        "de": "Erscheint in der Flottenverwaltung bei dieser Anlage, z. B. \"Womo Mercedes KA-1525\" (höchstens 200 Zeichen)"
                    },
                    "maxLength": 200,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "_connection": {
                    "type": "state",
                    "oid": "info.connection",
                    "label": { "en": "Fleet management", "de": "Flottenverwaltung" },
                    "trueText": { "en": "connected", "de": "verbunden" },
                    "falseText": { "en": "not connected", "de": "nicht verbunden" },
                    "trueTextStyle": { "color": "#4caf50", "fontWeight": "bold" },
                    "falseTextStyle": { "color": "#f44336", "fontWeight": "bold" },
                    "narrow": true,
                    "addColon": true,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "_status": {
                    "type": "state",
                    "oid": "info.status",
                    "label": { "en": "Status", "de": "Status" },
                    "narrow": true,
                    "addColon": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 9,
                    "xl": 9
                }
            }
        },
        "remote": {
            "type": "panel",
            "label": { "en": "Remote access", "de": "Fernzugriff" },
            "items": {
                "hdr3": {
                    "type": "staticText",
                    "text": {
                        "en": "Service staff of the fleet management can open admin or vis-2 of this system from afar, without ioBroker.pro and without open ports: on request, this adapter connects to the fleet server for the duration of the access. Every access is logged with person and purpose, and is shown below while it lasts. Changing these settings ends running accesses. The console is off until you allow it here.",
                        "de": "Servicepersonal der Flottenverwaltung kann admin oder vis-2 dieses Systems aus der Ferne öffnen, ohne ioBroker.pro und ohne offene Ports: auf Anforderung verbindet sich dieser Adapter für die Dauer des Zugriffs mit dem Flottenserver. Jeder Zugriff wird mit Person und Zweck protokolliert und unten angezeigt, solange er läuft. Eine Änderung dieser Einstellungen beendet laufende Zugriffe. Die Konsole ist aus, bis Sie sie hier erlauben."
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "allowAdmin": {
                    "type": "checkbox",
                    "label": { "en": "Allow remote access to admin", "de": "Fernzugriff auf admin erlauben" },
                    "help": {
                        "en": "admin means full access to the system",
                        "de": "admin bedeutet vollen Zugriff auf das System"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "allowVis": {
                    "type": "checkbox",
                    "label": { "en": "Allow remote access to vis-2 (web)", "de": "Fernzugriff auf vis-2 (web) erlauben" },
                    "help": {
                        "en": "vis-2 shows the values of this system, e.g. consumption",
                        "de": "vis-2 zeigt die Werte dieses Systems, z. B. Verbräuche"
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "allowConsole": {
                    "type": "checkbox",
                    "label": { "en": "Allow the console (a shell on this system)", "de": "Konsole erlauben (Shell auf diesem System)" },
                    "help": {
                        "en": "Only Linux. The shell runs as the user of ioBroker: full access to ioBroker, its data and, depending on the setup, to the system",
                        "de": "Nur Linux. Die Shell läuft als Nutzer von ioBroker: voller Zugriff auf ioBroker, seine Daten und, je nach Einrichtung, auf das System"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "_knxHeader": {
                    "type": "header",
                    "text": { "en": "KNX for ETS", "de": "KNX für ETS" },
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "allowKnx": {
                    "type": "checkbox",
                    "label": { "en": "Allow ETS to reach the KNX gateway", "de": "ETS den Zugang zum KNX-Gateway erlauben" },
                    "help": {
                        "en": "Service staff can program the KNX installation with ETS from afar, through the program bee-knx on their PC. Only to the gateway below, nothing else in this network.",
                        "de": "Servicepersonal kann die KNX-Anlage mit ETS aus der Ferne programmieren, über das Programm bee-knx auf seinem PC. Nur zum Gateway unten, zu nichts anderem in diesem Netz."
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "knxGateway": {
                    "type": "text",
                    "label": { "en": "KNX/IP gateway", "de": "KNX/IP-Gateway" },
                    "placeholder": "192.168.1.20",
                    "help": {
                        "en": "IP address or host name, with :port if not 3671. Empty: as set in the adapter knx or openknx",
                        "de": "IP-Adresse oder Hostname, mit :Port falls nicht 3671. Leer: wie im Adapter knx oder openknx eingestellt"
                    },
                    "hidden": "!data.allowKnx",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "knxTransport": {
                    "type": "select",
                    "label": { "en": "Connection to the gateway", "de": "Verbindung zum Gateway" },
                    "options": [
                        { "value": "auto", "label": { "en": "Automatic (TCP if possible, otherwise UDP)", "de": "Automatisch (TCP wenn möglich, sonst UDP)" } },
                        { "value": "tcp", "label": { "en": "TCP", "de": "TCP" } },
                        { "value": "udp", "label": { "en": "UDP", "de": "UDP" } }
                    ],
                    "hidden": "!data.allowKnx",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "_aiHeader": {
                    "type": "header",
                    "text": { "en": "AI access (MCP)", "de": "KI-Zugang (MCP)" },
                    "size": 5,
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "allowAi": {
                    "type": "checkbox",
                    "label": { "en": "Allow the AI access", "de": "KI-Zugang erlauben" },
                    "help": {
                        "en": "An AI of the fleet management works with the MCP server of ioBroker on this system, only while someone opened it there with purpose and duration. Needs Node.js 22.19",
                        "de": "Eine KI der Flottenverwaltung arbeitet mit dem MCP-Server von ioBroker auf diesem System, nur solange jemand sie dort mit Zweck und Dauer geöffnet hat. Braucht Node.js 22.19"
                    },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "aiUser": {
                    "type": "user",
                    "short": true,
                    "label": { "en": "Runs as ioBroker user", "de": "Läuft als ioBroker-Nutzer" },
                    "help": { "en": "The AI has the rights of this user", "de": "Die KI hat die Rechte dieses Nutzers" },
                    "hidden": "!data.allowAi",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "aiSetState": {
                    "type": "checkbox",
                    "label": { "en": "Also write states", "de": "Auch Werte schreiben" },
                    "help": { "en": "Otherwise the AI only reads", "de": "Sonst liest die KI nur" },
                    "hidden": "!data.allowAi",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "aiObjectChange": {
                    "type": "checkbox",
                    "label": { "en": "Also change objects and files", "de": "Auch Objekte und Dateien ändern" },
                    "hidden": "!data.allowAi",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "_remoteAccessBy": {
                    "type": "state",
                    "oid": "info.remoteAccessBy",
                    "label": { "en": "Remote access in progress", "de": "Laufender Fernzugriff" },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        },
        "maintenance": {
            "type": "panel",
            "label": { "en": "Maintenance window", "de": "Wartungsfenster" },
            "items": {
                "hdr2": {
                    "type": "staticText",
                    "text": {
                        "en": "Updates only run inside the maintenance window and when all conditions are met (e.g. installation not in use, battery charged, no roaming, vehicle standing).",
                        "de": "Updates laufen nur im Wartungsfenster und wenn alle Bedingungen erfüllt sind (z. B. Anlage nicht in Benutzung, Batterie geladen, kein Roaming, Fahrzeug steht)."
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "windowStart": {
                    "type": "text",
                    "label": { "en": "Window start (HH:MM)", "de": "Fenster Beginn (HH:MM)" },
                    "xs": 6,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3,
                    "newLine": true
                },
                "windowEnd": {
                    "type": "text",
                    "label": { "en": "Window end (HH:MM)", "de": "Fenster Ende (HH:MM)" },
                    "xs": 6,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "ignoreWindow": {
                    "type": "checkbox",
                    "label": { "en": "Ignore window (testing only)", "de": "Fenster ignorieren (nur für Tests)" },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "minFreeMb": {
                    "type": "number",
                    "min": 100,
                    "label": { "en": "Minimum free space (MB)", "de": "Mindestens freier Speicher (MB)" },
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3,
                    "newLine": true
                },
                "conditions": {
                    "type": "table",
                    "label": { "en": "Conditions for updates", "de": "Bedingungen für Updates" },
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12,
                    "items": [
                        {
                            "type": "text",
                            "attr": "label",
                            "title": { "en": "Label", "de": "Bezeichnung" },
                            "width": "25%"
                        },
                        {
                            "type": "objectId",
                            "attr": "stateId",
                            "title": { "en": "State", "de": "Datenpunkt" },
                            "width": "40%"
                        },
                        {
                            "type": "select",
                            "attr": "op",
                            "title": { "en": "Operator", "de": "Vergleich" },
                            "options": [
                                { "label": "==", "value": "==" },
                                { "label": "!=", "value": "!=" },
                                { "label": ">=", "value": ">=" },
                                { "label": ">", "value": ">" },
                                { "label": "<=", "value": "<=" },
                                { "label": "<", "value": "<" }
                            ],
                            "default": "==",
                            "width": "15%"
                        },
                        {
                            "type": "text",
                            "attr": "value",
                            "title": { "en": "Value", "de": "Wert" },
                            "width": "20%"
                        }
                    ]
                }
            }
        },
        "advanced": {
            "type": "panel",
            "label": { "en": "Advanced", "de": "Erweitert" },
            "items": {
                "heartbeatMinutes": {
                    "type": "number",
                    "min": 5,
                    "label": { "en": "Heartbeat interval (min)", "de": "Heartbeat-Intervall (min)" },
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "checkMinutes": {
                    "type": "number",
                    "min": 1,
                    "label": { "en": "Check interval (min)", "de": "Prüfintervall (min)" },
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "keepaliveSeconds": {
                    "type": "number",
                    "min": 30,
                    "label": { "en": "MQTT keepalive (s)", "de": "MQTT-Keepalive (s)" },
                    "help": { "en": "Longer saves mobile data", "de": "Länger spart Mobilfunkvolumen" },
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "signalStateId": {
                    "type": "objectId",
                    "label": { "en": "State with signal quality (optional)", "de": "Datenpunkt mit Signalqualität (optional)" },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6,
                    "newLine": true
                },
                "verifySeconds": {
                    "type": "number",
                    "min": 10,
                    "label": { "en": "Observation after update (s)", "de": "Beobachtung nach Update (s)" },
                    "help": { "en": "No new errors in the log during this time", "de": "In dieser Zeit keine neuen Fehler im Log" },
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3,
                    "newLine": true
                },
                "startTimeoutSeconds": {
                    "type": "number",
                    "min": 30,
                    "label": { "en": "Start timeout of instances (s)", "de": "Startfrist der Instanzen (s)" },
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 3,
                    "xl": 3
                },
                "backupBeforeUpdate": {
                    "type": "checkbox",
                    "label": { "en": "Backup before every update", "de": "Sicherung vor jedem Update" },
                    "help": { "en": "Disable for tests only", "de": "Nur für Tests abschalten" },
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                }
            }
        }
    }
}
